# FollowUpOS environment. Copy to .env.local (never commit real values).
# Only the two NEXT_PUBLIC_ values reach the browser — both are public by design.

# Supabase — Project Settings → API (or `npx supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — bypasses RLS

# App secrets — generate each with: openssl rand -base64 32
APP_URL=http://localhost:3001
APP_SECRET=                           # signs OAuth state + analyzer visitor cookie
TOKEN_ENCRYPTION_KEY=                 # AES-256-GCM key for Gmail tokens (32 bytes, base64)

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=                       # server only
GEMINI_MODEL=gemini-2.5-flash           # new Gemini accounts: gemini-3.8-flash (2.5 is closed to new users)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash   # used when the primary is overloaded

# Google OAuth (Gmail) — Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                 # server only
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/gmail/callback

# Limits
ANALYZER_VISITOR_LIMIT=5              # public analyzer, per visitor (server-enforced)
ANALYZER_USER_DAILY_LIMIT=50          # manual analyzer, signed-in owners, per day
APP_DAILY_ANALYSIS_LIMIT=200          # in-app conversation analyses, per business, per day
